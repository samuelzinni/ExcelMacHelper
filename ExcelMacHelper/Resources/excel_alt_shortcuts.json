{
  "_metadata": {
    "version": "1.0",
    "description": "Comprehensive Windows Excel Alt-Key Ribbon Shortcuts (Key Tips) for ExcelMacHelper macOS app",
    "note": "All sequences are press-and-release (sequential), NOT hold-together. E.g. Alt,H,O,I means: press Alt, release, press H, release, press O, release, press I, release.",
    "mac_action_types": "applescript = use AppleScript tell application 'Microsoft Excel', menu = simulate Mac menu navigation, keystroke = simulate keyboard shortcut"
  },
  "ribbon_tabs": {
    "F": "File",
    "H": "Home",
    "N": "Insert",
    "P": "Page Layout",
    "M": "Formulas",
    "A": "Data",
    "R": "Review",
    "W": "View",
    "L": "Developer",
    "Q": "Search/Tell Me"
  },
